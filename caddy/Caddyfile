{
    email admin@aquachecklab.com
}

lims.aquachecklab.com {
    route {
        coraza_waf {
            load_owasp_crs
            directives `
                Include @coraza.conf-recommended
                Include @crs-setup.conf.example
                # CRS rule 911100 enforces tx.allowed_methods, which defaults to
                # "GET HEAD POST OPTIONS". That blocks every update and delete in this API
                # at the WAF — the backend never sees the request, so the 403 comes back
                # from Caddy with an empty body and looks like a permissions failure.
                SecAction "id:900200,phase:1,nolog,pass,t:none,setvar:'tx.allowed_methods=GET HEAD POST OPTIONS PUT PATCH DELETE'"
                Include @owasp_crs/*.conf
                SecRuleEngine On
                SecRequestBodyAccess On
                SecResponseBodyAccess On
                SecResponseBodyMimeType text/plain text/html text/xml application/json
                SecRequestBodyLimit 13107200
                SecRequestBodyNoFilesLimit 131072
            `
        }

        # API traffic → FastAPI backend
        handle /api/* {
            reverse_proxy backend:8000
        }

        # Everything else → Next.js frontend
        handle {
            reverse_proxy frontend:3000
        }
    }

    log {
        output stdout
        format json
    }
}